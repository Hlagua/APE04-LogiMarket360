<Project Sdk="Microsoft.NET.Sdk">
  <!-- Presentación + composition root. Infrastructure se referencia SOLO para registrar dependencias (Program.cs). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>LogiMarket.WinForms</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LogiMarket.Application\LogiMarket.Application.csproj" />
    <ProjectReference Include="..\LogiMarket.Domain\LogiMarket.Domain.csproj" />
    <ProjectReference Include="..\LogiMarket.Infrastructure\LogiMarket.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.ejemplo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
